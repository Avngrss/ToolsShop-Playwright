{
  "name": "toolshop",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --project=ui",
    "test:api": "npx playwright test --project=api",
    "test:smoke": "npx playwright test --grep \"@smoke\"",
    "test:ui:smoke": "npx playwright test --project=ui --grep \"@smoke\"",
    "test:api:smoke": "npx playwright test --project=api --grep \"@smoke\"",
    "test:debug": "npx playwright test --project=ui --headed --debug",
    "test:ci": "npx playwright test --reporter=line,allure-playwright",
    "report:allure:gen": "npx allure generate ./allure-results --clean -o ./allure-report",
    "report:allure:open": "npx allure open ./allure-report",
    "test:allure": "npm run test -- --reporter=line,allure-playwright && npm run report:allure:gen && npm run report:allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.4.4",
    "axe-core": "^4.11.3"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "zod": "^4.3.5"
  }
}
